{
  "name": "they-told-me-proofstamp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/freetsa.integration.test.ts",
    "test:freetsa": "vitest run tests/freetsa.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "pages:dev": "wrangler pages dev dist"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12.0.2"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.15.0",
    "asn1js": "3.0.10",
    "pkijs": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  }
}
